#include <stdio.h>
#include <time.h>
int main() {
    int n = 500; 
    clock_t start, end;

    start = clock(); 

    long sum = 0;
    for (int i = 0; i < n; i++) {
        for(int j=0;j<n;j++){
        sum += i; 
        }
    }

    end = clock(); 

    double time_taken = (double)(end - start) / CLOCKS_PER_SEC;

    printf("Input size = %d\n, Execution time = %f seconds\n", n, time_taken);

    return 0;
}
